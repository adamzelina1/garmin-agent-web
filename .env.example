# Server-only infrastructure. Every user-facing setting is configured per
# account on the website (Settings -> Config) and stored in the users table:
#   - Garmin credentials/tokens (AES-GCM encrypted)
#   - LLM API key / base URL / model
#   - Home lat/lon (weather tool)
#   - Excluded data types + sync start date (per-account sync window)
# Nothing here needs to be set for those to work.

# --- Storage ----------------------------------------------------------------
# Postgres is the only backend. App (writer), read-only agent, and superuser.
GARMIN_DB_URL=postgresql://garmin_app:garmin_app@localhost:5432/garmin
GARMIN_READONLY_DB_URL=postgresql://garmin_readonly:garmin_readonly@localhost:5432/garmin
GARMIN_ADMIN_DB_URL=postgresql://garmin:garmin@localhost:5432/garmin

# --- Server / secrets ---------------------------------------------------------
# AES-GCM key (base64 of 32 bytes). Generate:
#   uv run python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
GARMIN_ENC_KEY=
# JWT signing secret (>=32 random bytes) and daemon cron token
GARMIN_JWT_SECRET=
GARMIN_CRON_TOKEN=
GARMIN_JWT_TTL_HOURS=24

# Background sync worker
GARMIN_SYNC_INTERVAL_MIN=60
# Syncs run serially when 1 — the conservative default for rate-limit safety.
GARMIN_SYNC_MAX_WORKERS=1
GARMIN_SYNC_TIMEOUT_MIN=30

# Rate-limit protection: sleep N seconds between every Garmin API call inside a
# sync. 0 (off) is the default; 2 is a good "be gentle" value on a backfill.
GARMIN_FETCH_SLEEP_SEC=0

# Sync tuning: how many trailing days of activities are re-scanned for late uploads
GARMIN_ACTIVITY_FREEZE_DAYS=7
