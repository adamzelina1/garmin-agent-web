# ==============================================================================
# Garmin health-data agent — environment template
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in YOUR values. `.env` is gitignored and
# never committed; this template is safe to share.
#
#   cp .env.example .env      (Linux/macOS)   or   copy .env.example .env  (Windows)
# ==============================================================================

# --- Garmin Connect credentials (required) -----------------------------------
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_password

# Path to the Garmin Connect token store (defaults to ~/.garminconnect).
# Tokens are cached here after the first login; you may be prompted for an MFA
# code on first run.
GARMIN_TOKENS_PATH=

# --- SQLite storage -----------------------------------------------------------
# Path to the database file (defaults to garmin.db in the project root).
GARMIN_DB_PATH=garmin.db

# --- Sync window ---------------------------------------------------------------
# Earliest date to backfill (YYYY-MM-DD). Syncs every date from here to today,
# skipping dates already in the DB. Empty means "latest stored + 1" per type.
GARMIN_START_DATE=2025-01-01

# How many trailing days of activities to re-scan each run to catch late
# uploads. Dates older than today-FREEZE_DAYS are finalized and never re-synced.
GARMIN_ACTIVITY_FREEZE_DAYS=7

# Comma-separated list of data types to NEVER sync (removed from the default
# set). Useful for features you don't have (e.g. no training readiness device).
GARMIN_EXCLUDED_DATA_TYPES=training_readiness,morning_training_readiness,fitnessage,hydration

# --- LLM agent (garmin-ask / garmin-ask-web) ---------------------------------
# Cloud by default. Set LLM_BASE_URL to a local Ollama endpoint to keep data
# on-machine (e.g. LLM_BASE_URL=http://localhost:11434/v1 with LLM_MODEL set
# to a model you have pulled).
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# OpenAI-compatible alternative (only if not using LLM_API_KEY):
# OPENAI_API_KEY=
# LLM_BASE_URL=

# --- Weather tool (agent) ------------------------------------------------------
# Home location used by the agent's `weather` tool (historical + forecast).
# Optional; the agent can also be told explicit lat/lon per call.
GARMIN_HOME_LAT=
GARMIN_HOME_LON=

# --- Runtime files (all optional; default to project root) --------------------
# Long-term memory profile the agent reads/writes (JSON).
GARMIN_MEMORY_FILE=agent_memory.json
# Web chat session persistence (auto-saved/resumed by garmin-ask-web).
GARMIN_WEB_SESSION_FILE=web_session.json
# Agent tool-call trace log (JSONL) rendered by garmin-trace.
GARMIN_TRACE_FILE=ask_trace.jsonl
